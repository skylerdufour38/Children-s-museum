{
  "name": "iOS App Archive Catalog",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Static catalog preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python3 -m http.server 8000 --directory /workspaces/Children-s-museum",
  "customizations": {
    "vscode": {
      "settings": {
        "liveServer.settings.port": 8000,
        "liveServer.settings.root": "/workspaces/Children-s-museum"
      }
    }
  }
}
